# GlanceJobs Job Tracker — local environment overrides
# Copy to .env (gitignored) to override the defaults.

# Firebase Web SDK (Project Settings → Your apps → Web) — shared with glancejobsUI.
# Leave blank to use the same defaults baked into src/lib/firebase.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Backend API base URL (javascript-glancejobs). Local dev default matches
# that repo's `npm run dev` port.
VITE_SEARCH_API_BASE=http://localhost:8080

# glancejobsUI marketing site origin, for the sidebar's "Companies" link
# (opens the existing /sponsorship-search/ page there). Fill in the real
# production domain before deploying — TODO: confirm with team.
VITE_MARKETING_SITE_URL=https://glancejobs.com
